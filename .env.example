# Copy this file to .env for local configuration. Never commit .env.
APP_TITLE=BDC Analytics Agent
APP_ENV=local
# Private APP_ENV=production requires server OIDC secrets and an explicit access map.
# Explicit public demo: bundled synthetic data only; all LLM connections disabled.
PUBLIC_DEMO_ENABLED=false

# Optional cloud provider; select OpenAI explicitly in application Settings.
# On Render, set secrets through environment variables instead of a committed file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# A remote Ollama origin requires HTTPS and a protected proxy with this token.
OLLAMA_API_TOKEN=
OPENAI_FALLBACK_TO_OLLAMA=true
LLM_TIMEOUT_SECONDS=30
MAX_TOOL_CALLS=6
INVESTIGATION_DEPTH=3
INVESTIGATION_TIMEOUT_SECONDS=120
RESULT_LIMIT=500
DUCKDB_MEMORY_LIMIT=512MB
